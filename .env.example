# Copy this file to .env and fill in real values before running in production.

# Required — a long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's URL).
# Leave blank during local development to allow all origins.
CORS_ORIGIN=

# Database connection. Leave both blank for local dev — defaults to a local
# ./data.sqlite file, no account needed. For production on Turso, set both:
DB_URL=
DB_AUTH_TOKEN=

# Optional — Discord Incoming Webhook URL. Leave blank to disable notifications
# entirely (nothing breaks, nothing is sent). To enable later: in your Discord
# server, go to a channel's Settings → Integrations → Webhooks → New Webhook,
# copy its URL here. The app will then post a message whenever someone applies,
# a manager or HR approves/rejects, or an employee cancels a request.
DISCORD_WEBHOOK_URL=
